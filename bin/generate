#!/usr/bin/env bash

set -euo pipefail

cd "$(dirname "$0")/.."

DOCUMENTS_DIR="./documents"
PARAGRAPHS_PER_WORK="60"
REFRESH_SCALING="false"
SCALING_WORKERS="1"
RETRAIN="false"
WITH_BOOK="false"
DRY_RUN="false"
REQUESTED_STAGES=()
SKIPPED_STAGES=()

AGNEWS_MODEL="artifacts/models/projector.pth"
AGNEWS_CODEBOOK="codebook_4096"
STRUCTURED_MODEL="artifacts/models/structured_projector.pth"
STRUCTURED_CODEBOOK="interpretability_codebook"
DOCUMENTS_MODEL="artifacts/models/projector_documents_valsel.pth"
DOCUMENTS_CODEBOOK="codebook_documents_valsel"
LOSSLESS_BOOK="dickens/a_christmas_carol.txt"
LOSSLESS_PAGE="reports/figures/lossless_a_christmas_carol.png"
LOSSLESS_ROUND_TRIP="artifacts/encoded/a_christmas_carol_recovered.txt"
LOSSLESS_CORPUS_DIR="reports/figures/lossless"
SCALING_MANIFEST="reports/data/authorship_scaling.json"
TWO_WAYS_BOOK="darwin__origin_of_species"
TWO_WAYS_TITLE="On the Origin of Species — two ways to colour a book"
BOOK_SUMMARY="A lighthouse keeper on a fog-bound coast befriends the ghost of a drowned sailor."
BOOK_TONE="sombre, tender"
BOOK_BEATS="6"
BOOK_WORDS_PER_BEAT="500"

ALL_STAGES=(
  models
  eval-suite
  interpretability
  rate-distortion
  compass
  grounding
  documents-figures
  documents-rate-distortion
  authorship
  lossless
  lossless-corpus
  lossless-figures
  book
)

stage_description() {
  case "$1" in
    models)
      echo "prerequisite projectors and codebooks under artifacts/ (reused when present)" ;;
    eval-suite)
      echo "reports/eval_results.md" ;;
    interpretability)
      echo "reports/interpretability.md" ;;
    rate-distortion)
      echo "reports/rate_distortion.md, reports/figures/rate_distortion.png" ;;
    compass)
      echo "reports/story_compass.md, reports/figures/story_compass.png" ;;
    grounding)
      echo "reports/grounding_audit.md" ;;
    documents-figures)
      echo "reports/figures/documents_color_tsne.png, documents_color_signatures.png, documents_a4_gallery.png, a4/*.png" ;;
    documents-rate-distortion)
      echo "reports/documents_rate_distortion.md, reports/figures/documents_rate_distortion.png" ;;
    authorship)
      echo "reports/documents_authorship.md, reports/data/authorship_scaling.json (with --refresh-scaling)" ;;
    lossless)
      echo "reports/figures/lossless_a_christmas_carol.png" ;;
    lossless-corpus)
      echo "reports/figures/lossless/<author>__<work>.png for every book in the corpus" ;;
    lossless-figures)
      echo "reports/figures/documents_lossless_gallery.png, reports/figures/documents_two_ways.png" ;;
    book)
      echo "reports/book/*.md, reports/figures/story_book.png (needs --with-book and a live API key)" ;;
  esac
}

usage() {
  echo "Usage: $0 [OPTIONS]"
  echo ""
  echo "Regenerate the artifacts under ./reports/ by running the project CLIs with the exact"
  echo "arguments each report records in its own 'Reproduce' section. Existing files are"
  echo "overwritten in place; use --dry-run to preview the commands first."
  echo ""
  echo "Stages run in order and each one prints the command it invokes:"
  local stage
  for stage in "${ALL_STAGES[@]}"; do
    printf '  %-26s %s\n' "${stage}" "$(stage_description "${stage}")"
  done
  echo ""
  echo "Options:"
  echo "  --only <stage>        Run only this stage (repeatable)"
  echo "  --skip <stage>        Skip this stage (repeatable)"
  echo "  --documents-dir <p>   Authored corpus location (default: ${DOCUMENTS_DIR})"
  echo "  --refresh-scaling     Re-run the 24-training authorship scaling sweep"
  echo "  --scaling-workers <n> Train the sweep grid across n processes (default: ${SCALING_WORKERS})"
  echo "  --retrain             Retrain the projectors even when their artifacts exist"
  echo "  --with-book           Also run the book stage (spends a live LLM call)"
  echo "  --dry-run             Print the commands without running them"
  echo "  -l, --list            List the stages and exit"
  echo "  -h, --help            Show this help"
  echo ""
  echo "Notes:"
  echo "  The documents-* stages, authorship and lossless read the git-ignored ./documents/"
  echo "  corpus and are skipped when it is absent; the remaining stages are self-contained."
  echo "  Retraining moves the reported numbers, so the projectors are reused when present."
  echo "  The book stage cannot reproduce a previous book: 'tox -e generate' needs a live API"
  echo "  key and the LLM is unseeded, so it is opt-in and writes a NEW book each time."
  echo ""
  echo "  These reports/ files have no generator anywhere in the repository and cannot be"
  echo "  regenerated by any stage: figures/documents_lossless_gallery.png,"
  echo "  figures/documents_two_ways.jpg, figures/pipeline_preview.png, linkedin_post.md."
}

handle_options() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --only)
        [ $# -ge 2 ] || { echo "Error: $1 requires a value" >&2; exit 1; }
        REQUESTED_STAGES+=("$2"); shift 2 ;;
      --skip)
        [ $# -ge 2 ] || { echo "Error: $1 requires a value" >&2; exit 1; }
        SKIPPED_STAGES+=("$2"); shift 2 ;;
      --documents-dir)
        [ $# -ge 2 ] || { echo "Error: $1 requires a value" >&2; exit 1; }
        DOCUMENTS_DIR="$2"; shift 2 ;;
      --refresh-scaling)
        REFRESH_SCALING="true"; shift ;;
      --scaling-workers)
        [ $# -ge 2 ] || { echo "Error: $1 requires a value" >&2; exit 1; }
        SCALING_WORKERS="$2"; shift 2 ;;
      --retrain)
        RETRAIN="true"; shift ;;
      --with-book)
        WITH_BOOK="true"; shift ;;
      --dry-run)
        DRY_RUN="true"; shift ;;
      -l | --list)
        list_stages; exit 0 ;;
      -h | --help)
        usage; exit 0 ;;
      --)
        shift ;;
      *)
        echo "Invalid option: $1" >&2; usage; exit 1 ;;
    esac
  done
}

list_stages() {
  local stage
  for stage in "${ALL_STAGES[@]}"; do
    printf '%-26s %s\n' "${stage}" "$(stage_description "${stage}")"
  done
}

is_known_stage() {
  local candidate
  for candidate in "${ALL_STAGES[@]}"; do
    if [ "${candidate}" = "$1" ]; then
      return 0
    fi
  done
  return 1
}

validate_requested_stages() {
  local stage
  for stage in "${REQUESTED_STAGES[@]}" "${SKIPPED_STAGES[@]}"; do
    if ! is_known_stage "${stage}"; then
      echo "Error: unknown stage: ${stage}" >&2
      echo "" >&2
      list_stages >&2
      exit 1
    fi
  done
}

contains_stage() {
  local wanted="$1"
  shift
  local candidate
  for candidate in "$@"; do
    if [ "${candidate}" = "${wanted}" ]; then
      return 0
    fi
  done
  return 1
}

is_selected() {
  if [ "${#REQUESTED_STAGES[@]}" -gt 0 ] && ! contains_stage "$1" "${REQUESTED_STAGES[@]}"; then
    return 1
  fi
  if [ "${#SKIPPED_STAGES[@]}" -gt 0 ] && contains_stage "$1" "${SKIPPED_STAGES[@]}"; then
    return 1
  fi
  return 0
}

selected_stages() {
  local stage
  for stage in "${ALL_STAGES[@]}"; do
    if is_selected "${stage}"; then
      echo "${stage}"
    fi
  done
}

announce() {
  echo ""
  echo "---------------------------------------"
  echo "$1"
  echo "---------------------------------------"
}

run() {
  echo "+ $*"
  if [ "${DRY_RUN}" = "true" ]; then
    return 0
  fi
  "$@"
}

require_tox() {
  if command -v tox >/dev/null 2>&1; then
    return 0
  fi
  echo "Error: tox is not on PATH" >&2
  echo "Install the gate runner first: uv tool install --python 3.11 --with tox-uv tox" >&2
  exit 1
}

documents_corpus_available() {
  if [ -d "${DOCUMENTS_DIR}" ]; then
    return 0
  fi
  echo "Skipping: ${DOCUMENTS_DIR} is not present (the authored corpus is git-ignored)."
  return 1
}

model_artifacts_present() {
  [ -f "$1" ] && [ -f "artifacts/codebooks/$2.pkl" ]
}

needs_training() {
  if [ "${RETRAIN}" = "true" ]; then
    return 0
  fi
  if model_artifacts_present "$1" "$2"; then
    echo "Reusing $1 and artifacts/codebooks/$2.pkl"
    return 1
  fi
  return 0
}

train_agnews_projector() {
  if ! needs_training "${AGNEWS_MODEL}" "${AGNEWS_CODEBOOK}"; then
    return 0
  fi
  run tox -e train -- \
    --config configs/agnews_run.yaml \
    --mapper-type supervised \
    --output-model "${AGNEWS_MODEL}" \
    --output-codebook "${AGNEWS_CODEBOOK}"
}

train_structured_projector() {
  if ! needs_training "${STRUCTURED_MODEL}" "${STRUCTURED_CODEBOOK}"; then
    return 0
  fi
  run tox -e train -- \
    --config configs/interpretability.yaml \
    --mapper-type structured \
    --output-model "${STRUCTURED_MODEL}" \
    --output-codebook "${STRUCTURED_CODEBOOK}"
}

train_documents_projector() {
  if ! needs_training "${DOCUMENTS_MODEL}" "${DOCUMENTS_CODEBOOK}"; then
    return 0
  fi
  if ! documents_corpus_available; then
    return 0
  fi
  run tox -e train -- \
    --config configs/documents.yaml \
    --source documents \
    --documents-dir "${DOCUMENTS_DIR}" \
    --mapper-type supervised \
    --select-on validation \
    --paragraphs-per-work "${PARAGRAPHS_PER_WORK}" \
    --output-model "${DOCUMENTS_MODEL}" \
    --output-codebook "${DOCUMENTS_CODEBOOK}"
}

stage_models() {
  train_agnews_projector
  train_structured_projector
  train_documents_projector
}

stage_eval_suite() {
  run tox -e eval_suite -- \
    --datasets ag_news imdb newsgroups \
    --methods color tfidf hnsw \
    --distance sliced \
    --budgets 4000 600 600 \
    --fidelity-accuracy-delta 0.0 \
    --config configs/agnews_full.yaml \
    --mapper-type unconstrained \
    --task both \
    --k-values 1 5 10
}

stage_interpretability() {
  run tox -e interpretability -- \
    --dataset imdb \
    --structured-model "${STRUCTURED_MODEL}" \
    --control noise \
    --max-samples 400 \
    --config configs/interpretability.yaml
}

stage_rate_distortion() {
  run tox -e rate_distortion -- \
    --dataset ag_news \
    --budgets 2 4 8 16 \
    --methods color_vq gzip pq \
    --with-accuracy \
    --distance jensen_shannon \
    --max-samples 200 \
    --config configs/base.yaml \
    --output-path reports/rate_distortion.md \
    --figure-path reports/figures/rate_distortion.png
}

stage_compass() {
  run tox -e compass -- \
    --outline outlines/sample_story.md \
    --config configs/structured.yaml \
    --model-path "${STRUCTURED_MODEL}" \
    --codebook-name "${AGNEWS_CODEBOOK}" \
    --mapper structured \
    --metric sliced \
    --min-beat-chars 200 \
    --drift-threshold 36.5
}

stage_grounding() {
  run tox -e grounding -- \
    --sample samples/rag_grounding.yaml \
    --config configs/base.yaml \
    --model-path "${AGNEWS_MODEL}" \
    --codebook-name "${AGNEWS_CODEBOOK}" \
    --mapper plain \
    --metric sliced \
    --threshold 25.0
}

stage_documents_figures() {
  if ! documents_corpus_available; then
    return 0
  fi
  run tox -e visualize_documents -- \
    --config configs/documents.yaml \
    --model-path "${DOCUMENTS_MODEL}" \
    --codebook-name "${DOCUMENTS_CODEBOOK}" \
    --mapper-type supervised \
    --documents-dir "${DOCUMENTS_DIR}"
}

stage_documents_rate_distortion() {
  if ! documents_corpus_available; then
    return 0
  fi
  run tox -e rate_distortion -- \
    --source documents \
    --documents-dir "${DOCUMENTS_DIR#./}" \
    --split-strategy work \
    --min-paragraph-chars 200 \
    --paragraphs-per-work "${PARAGRAPHS_PER_WORK}" \
    --validation-fraction 0.2 \
    --test-fraction 0.2 \
    --budgets 2 4 8 16 \
    --methods color_vq gzip pq \
    --with-accuracy \
    --distance jensen_shannon \
    --max-samples 300 \
    --config configs/documents.yaml \
    --output-path reports/documents_rate_distortion.md \
    --figure-path reports/figures/documents_rate_distortion.png
}

stage_authorship() {
  if ! documents_corpus_available; then
    return 0
  fi
  local scaling_flags=()
  if [ "${REFRESH_SCALING}" = "true" ]; then
    scaling_flags=(--refresh-scaling)
    echo "Re-running the 24-training scaling sweep across ${SCALING_WORKERS} worker(s); ~7 h at 1 worker"
  else
    echo "Reusing committed ${SCALING_MANIFEST}; --refresh-scaling re-runs the 24-training sweep (~7 h serial,"
    echo "  ~2 h at --scaling-workers 4)"
  fi
  run tox -e authorship -- \
    --config configs/documents.yaml \
    --model-path "${DOCUMENTS_MODEL}" \
    --codebook-name "${DOCUMENTS_CODEBOOK}" \
    --mapper-type supervised \
    --documents-dir "${DOCUMENTS_DIR}" \
    --paragraphs-per-work "${PARAGRAPHS_PER_WORK}" \
    --distance jensen_shannon \
    --scaling-workers "${SCALING_WORKERS}" \
    "${scaling_flags[@]}"
}

stage_lossless() {
  if ! documents_corpus_available; then
    return 0
  fi
  run tox -e encode_lossless -- \
    --input-path "${DOCUMENTS_DIR}/${LOSSLESS_BOOK}" \
    --output-path "${LOSSLESS_PAGE}"
  verify_lossless_round_trip
}

verify_lossless_round_trip() {
  run mkdir -p "$(dirname "${LOSSLESS_ROUND_TRIP}")"
  run tox -e decode_lossless -- \
    --input-paths "${LOSSLESS_PAGE}" \
    --output-path "${LOSSLESS_ROUND_TRIP}"
  run cmp "${DOCUMENTS_DIR}/${LOSSLESS_BOOK}" "${LOSSLESS_ROUND_TRIP}"
  if [ "${DRY_RUN}" != "true" ]; then
    echo "Lossless page decodes back to the source text byte-for-byte"
  fi
}

stage_lossless_corpus() {
  if ! documents_corpus_available; then
    return 0
  fi
  local book author work
  echo "Encoding $(find "${DOCUMENTS_DIR}" -mindepth 2 -name '*.txt' | wc -l) books into ${LOSSLESS_CORPUS_DIR}"
  while IFS= read -r book; do
    author="$(basename "$(dirname "${book}")")"
    work="$(basename "${book}" .txt)"
    run tox -e encode_lossless -- \
      --input-path "${book}" \
      --output-path "${LOSSLESS_CORPUS_DIR}/${author}__${work}.png"
  done < <(find "${DOCUMENTS_DIR}" -mindepth 2 -name '*.txt' | sort)
}

stage_lossless_figures() {
  if ! documents_corpus_available; then
    return 0
  fi
  run tox -e visualize_lossless -- \
    --lossless-dir "${LOSSLESS_CORPUS_DIR}" \
    --sheets-dir reports/figures/a4 \
    --book "${TWO_WAYS_BOOK}" \
    --title "${TWO_WAYS_TITLE}"
}

stage_book() {
  if [ "${WITH_BOOK}" != "true" ]; then
    echo "Skipping: book generation spends a live LLM call and is unseeded; pass --with-book to run it."
    return 0
  fi
  if [ -z "${ANTHROPIC_API_KEY:-}${ANTHROPIC_AUTH_TOKEN:-}" ]; then
    echo "Skipping: neither ANTHROPIC_API_KEY nor ANTHROPIC_AUTH_TOKEN is set."
    return 0
  fi
  run tox -e generate -- \
    --summary "${BOOK_SUMMARY}" \
    --num-beats "${BOOK_BEATS}" \
    --words-per-beat "${BOOK_WORDS_PER_BEAT}" \
    --tone "${BOOK_TONE}" \
    --config configs/structured.yaml \
    --model-path "${STRUCTURED_MODEL}"
}

dispatch_stage() {
  case "$1" in
    models) stage_models ;;
    eval-suite) stage_eval_suite ;;
    interpretability) stage_interpretability ;;
    rate-distortion) stage_rate_distortion ;;
    compass) stage_compass ;;
    grounding) stage_grounding ;;
    documents-figures) stage_documents_figures ;;
    documents-rate-distortion) stage_documents_rate_distortion ;;
    authorship) stage_authorship ;;
    lossless) stage_lossless ;;
    lossless-corpus) stage_lossless_corpus ;;
    lossless-figures) stage_lossless_figures ;;
    book) stage_book ;;
  esac
}

run_stage() {
  local started="${SECONDS}"
  announce "$1 -> $(stage_description "$1")"
  dispatch_stage "$1"
  echo "Completed $1 in $((SECONDS - started))s"
}

summarize() {
  announce "Regenerated artifacts"
  if [ "${DRY_RUN}" = "true" ]; then
    echo "Dry run: nothing was written."
    return 0
  fi
  local changes
  changes="$(git status --short reports/ 2>/dev/null || true)"
  if [ -z "${changes}" ]; then
    echo "Every regenerated artifact matches the committed one."
  else
    echo "${changes}"
  fi
  echo ""
  echo "Total time: ${SECONDS}s"
}

handle_options "$@"
validate_requested_stages
require_tox
mapfile -t STAGES < <(selected_stages)

for stage in "${STAGES[@]}"; do
  run_stage "${stage}"
done
summarize
