#!/usr/bin/env bash

set -euo pipefail

tox -e build

wheel=$(basename "$(find dist -name "*.whl" -exec ls -t1 {} + | head -1)")

if [ -z "$wheel" ]; then
  echo "create-service: no wheel in dist; cannot determine the service version" >&2
  exit 1
fi

version=$(cut -d - -f 2 <<<"$wheel" | tr + .)

if [ -z "$version" ]; then
  echo "create-service: could not read a version from ${wheel}" >&2
  exit 1
fi

cp build/openapi.json "build/${version}.json"

packer build -color=false -var "whl=${wheel}" -var "version=${version}" infrastructure/packer/service.pkr.hcl

echo "VERSION=${version}"
